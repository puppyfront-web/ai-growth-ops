{
  "name": "ai-growth-ops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- pnpm prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:push": "dotenv -e .env -- pnpm prisma db push --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env packages/database/prisma/seed.ts",
    "db:reset:test": "dotenv -e .env -- pnpm prisma migrate reset --force --skip-seed --schema packages/database/prisma/schema.prisma",
    "dev": "pnpm --filter @ai-growth-ops/api dev",
    "dev:web": "pnpm --filter @ai-growth-ops/web dev",
    "dev:browser-runner": "pnpm --filter @ai-growth-ops/browser-runner dev",
    "docker:down": "docker compose down -v",
    "docker:up": "docker compose up -d",
    "e2e": "playwright test",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.60.0",
    "@prisma/client": "5.22.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.15.30",
    "dotenv": "^17.2.3",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
