{
  "name": "ai-growth-ops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm lint && pnpm -r --if-present build",
    "db:generate": "pnpm prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "pnpm prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "pnpm prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:prune-migrations": "node scripts/prune-migration-ghosts.mjs",
    "db:push": "pnpm prisma db push --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx --env-file-if-exists=.env packages/database/prisma/seed.ts",
    "db:reset:test": "node scripts/with-e2e-database.mjs pnpm prisma migrate reset --force --skip-seed --schema packages/database/prisma/schema.prisma",
    "dev": "pnpm --filter @ai-growth-ops/api dev",
    "dev:web": "pnpm --filter @ai-growth-ops/web dev",
    "dev:browser-runner": "pnpm --filter @ai-growth-ops/browser-runner dev",
    "docker:down": "docker compose down -v",
    "docker:up": "docker compose up -d",
    "e2e": "playwright test",
    "format:check": "prettier --check .",
    "secrets:migrate-local": "tsx --env-file=.env scripts/migrate-secrets-to-local.ts",
    "local:prepare": "node --env-file-if-exists=.env scripts/prepare-local-data.mjs",
    "local:backup": "node --env-file-if-exists=.env scripts/backup-local-data.mjs",
    "local:restore": "node --env-file-if-exists=.env scripts/restore-local-data.mjs",
    "lint": "eslint .",
    "test": "node --test scripts/test-database-url.test.mjs && vitest run && pnpm test:web",
    "test:architecture": "tsx scripts/check-architecture-drift.ts && vitest run tests/unit/harness/architecture-drift.test.ts tests/unit/deployment/local-only-runtime.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/with-e2e-database.mjs pnpm db:push && vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:web": "vitest run --config vitest.web.config.ts",
    "verify:release": "pnpm lint && pnpm typecheck && pnpm test:architecture && pnpm db:reset:test && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "1.62.0",
    "@prisma/client": "5.22.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.15.30",
    "dotenv": "^17.2.3",
    "eslint": "^9.27.0",
    "eslint-plugin-jsonc": "^3.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
