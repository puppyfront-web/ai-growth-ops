{
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "reasoning": { "type": "string" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "call",
              "wecom_message",
              "email",
              "meeting",
              "send_material",
              "follow_up_note"
            ]
          },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "dueInDays": { "type": "number" },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["type", "title", "content"]
      }
    }
  },
  "required": ["summary", "actions"]
}
