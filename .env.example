# ════════════════════════════════════════════════════════════════
# AI Growth Ops — 环境变量模板
# 复制为 .env 并填入真实值。本地开发用 docker-compose 提供的默认值即可跑通。
# 生产部署请务必更换所有 CHANGE_ME 标记的密钥。
# ════════════════════════════════════════════════════════════════

# ── 数据库 (PostgreSQL,由 docker-compose 提供) ───────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_growth_ops
POSTGRES_DB=ai_growth_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── Redis (BullMQ 队列 + 缓存,由 docker-compose 提供) ────────
REDIS_URL=redis://localhost:6379

# ── 鉴权密钥(生产必须更换) ──────────────────────────────────
# 32 位随机字符串,用于签发 JWT。生成:openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_RANDOM_32CHAR_SECRET
# 加密 PlatformAccount.cookieRef 等敏感字段。生成:openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32CHAR_SECRET

# ── 服务地址 ─────────────────────────────────────────────────
APP_URL=http://localhost:3001
API_PORT=3100
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3100

# ── AI / LLM(驱动评论分类、回复生成、内容创作) ──────────────
# 选一个 provider 即可。两种都配则 OPENAI 优先。
AI_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6-20250514

# ── Vision 兜底(可选,强烈推荐) ────────────────────────────
# 配置后,browser-runner 在 CSS 选择器失效时会截图交给视觉模型定位元素,
# 大幅提升抖音/小红书改版后的稳定性。复用上面的 OPENAI_* 配置即可,
# 也可单独指定:
# VISION_MODEL=gpt-4o
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=sk-xxx

# ── Browser Runner(浏览器自动化服务) ────────────────────────
BROWSER_RUNNER_URL=http://localhost:3200
BROWSER_RUNNER_PORT=3200
# 扫码登录/二次验证需要有头浏览器(true=弹出窗口,false=无头)
BROWSER_RUNNER_HEADED=true
# browser-runner 内部鉴权密钥(API 调用它时需带)。留空则回退到 TOKEN_ENCRYPTION_KEY
# BROWSER_RUNNER_SECRET=CHANGE_ME

# ── 对象存储 (MinIO / S3,由 docker-compose 提供) ───────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-growth-ops

# ── 邮件(可选,默认打印到控制台) ───────────────────────────
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=AI Growth Ops <noreply@yourdomain.com>

# ── 平台连接器(可选,按需开启) ─────────────────────────────
# WECHAT_APP_ID=xxx
# WECHAT_APP_SECRET=xxx
# DOUYIN_CLIENT_KEY=xxx
# DOUYIN_CLIENT_SECRET=xxx
# XIAOHONGSHU_COOKIE=xxx

# ── 每日 Agent 运行(可选) ──────────────────────────────────
# AGENT_DAILY_DRY_RUN=false  # 留空=安全 dry-run;设 false 需先配好 cookie
# FEISHU_DAILY_REPORT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ── 可观测性(可选) ─────────────────────────────────────────
# LOG_LEVEL=info
# SENTRY_DSN=https://xxx@sentry.io/xxx
